# Optional: BallDNA works in template mode without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional overrides
HOOPLENS_DB_PATH=data/hooplens.db
HOOPLENS_HISTORICAL_DATA_DIR=data/historical
HOOPLENS_PROMPT_VERSION=v1.0

# Data refresh defaults. The current app database can be refreshed with:
# python scripts/sync_nba_data.py
HOOPLENS_NBA_SEASON=2025-26
HOOPLENS_MIN_GAMES=1
HOOPLENS_RECENT_GAMES=10
